# ══════════════════════════════════════════════════════════
# WhatsApp AI Assistant — Configuração
# Copie este arquivo para .env e preencha os valores
# ══════════════════════════════════════════════════════════

# ── WhatsApp Cloud API (Meta) ──────────────────────────────
# Obtenha em: https://developers.facebook.com/apps/
# 1. Crie um App > WhatsApp > API Setup
# 2. Copie o Phone Number ID e o Access Token

WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_aqui
WHATSAPP_TOKEN=seu_access_token_aqui

# Token que você define para verificar o webhook (pode ser qualquer string)
WEBHOOK_VERIFY_TOKEN=meu-token-secreto-123

# ── Anthropic (Claude AI) ──────────────────────────────────
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo da IA (padrão: claude-sonnet-4-6)
# Opções: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001
AI_MODEL=claude-sonnet-4-6

# ── Servidor ───────────────────────────────────────────────
PORT=3000

# ══════════════════════════════════════════════════════════
# COMO CONFIGURAR O WEBHOOK NO META:
#
# 1. Suba o servidor com: npm start
# 2. Use ngrok para expor localmente: ngrok http 3000
# 3. No painel Meta, configure o Webhook URL:
#    https://SUA-URL-NGROK.ngrok.io/webhook
# 4. Configure o Verify Token com o valor de WEBHOOK_VERIFY_TOKEN
# 5. Assine os eventos: messages, message_status
# ══════════════════════════════════════════════════════════
